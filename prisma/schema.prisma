// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model for authentication and profiles
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  role          String    @default("user") // user, artist, admin
  image         String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  artists       Artist[]
  orders        Order[]
  bookings      Booking[]
  posts         Post[]
  comments      Comment[]
  newsletters   Newsletter[]
}

// Artist profiles
model Artist {
  id            String    @id @default(cuid())
  userId        String    @unique
  artistName    String
  genre         String?
  bio           String?
  imageUrl      String?
  portfolioUrl  String?
  spotifyUrl    String?
  soundcloudUrl String?
  instagramUrl  String?
  featured      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects      Project[]
  events        Event[]
}

// Projects (albums, singles, videos, etc.)
model Project {
  id            String    @id @default(cuid())
  artistId      String
  title         String
  description   String?
  type          String    // album, single, video, film, etc.
  releaseDate   DateTime?
  imageUrl      String?
  mediaUrl      String?
  featured      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  artist        Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
}

// Services offered
model Service {
  id            String    @id @default(cuid())
  name          String
  description   String
  price         Float?
  category      String    // recording, branding, video, social, events, consulting
  imageUrl      String?
  available     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  bookings      Booking[]
}

// Bookings for services
model Booking {
  id            String    @id @default(cuid())
  userId        String
  serviceId     String
  date          DateTime
  status        String    @default("pending") // pending, confirmed, completed, cancelled
  notes         String?
  totalPrice    Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  service       Service   @relation(fields: [serviceId], references: [id])
}

// E-commerce products
model Product {
  id            String    @id @default(cuid())
  name          String
  description   String
  price         Float
  category      String    // merch, music, art, etc.
  imageUrl      String?
  stock         Int       @default(0)
  available     Boolean   @default(true)
  featured      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  orderItems    OrderItem[]
}

// Orders
model Order {
  id            String    @id @default(cuid())
  userId        String
  status        String    @default("pending") // pending, processing, shipped, delivered, cancelled
  total         Float
  shippingAddress String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]
}

// Order items
model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  productId     String
  quantity      Int
  price         Float
  
  // Relations
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id])
}

// Events
model Event {
  id            String    @id @default(cuid())
  artistId      String?
  title         String
  description   String
  date          DateTime
  location      String
  ticketUrl     String?
  imageUrl      String?
  featured      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  artist        Artist?   @relation(fields: [artistId], references: [id], onDelete: SetNull)
}

// Blog/Community posts
model Post {
  id            String    @id @default(cuid())
  userId        String
  title         String
  content       String
  published     Boolean   @default(false)
  featured      Boolean   @default(false)
  imageUrl      String?
  category      String?   // news, insights, tutorials, etc.
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments      Comment[]
}

// Comments
model Comment {
  id            String    @id @default(cuid())
  postId        String
  userId        String
  content       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Newsletter subscriptions
model Newsletter {
  id            String    @id @default(cuid())
  email         String    @unique
  userId        String?
  subscribed    Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}
